{
  "name": "iphelper",
  "version": "1.0.0",
  "description": "macOS 网络快速切换工具 - 多套网络配置存档、一键切换静态IP/DHCP",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --arm64 --x64",
    "build:arm64": "electron-builder --mac --arm64",
    "build:x64": "electron-builder --mac --x64"
  },
  "build": {
    "appId": "com.iphelper.app",
    "productName": "IPHelper",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "configs/**/*",
      "log.txt"
    ]
  },
  "author": "IPHelper",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
