{
  "name": "iphelper",
  "version": "1.0.3",
  "description": "macOS \u7f51\u7edc\u5feb\u901f\u5207\u6362\u5de5\u5177 - \u591a\u5957\u7f51\u7edc\u914d\u7f6e\u5b58\u6863\u3001\u4e00\u952e\u5207\u6362\u9759\u6001IP/DHCP",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --arm64 --x64",
    "build:arm64": "electron-builder --mac --arm64",
    "build:x64": "electron-builder --mac --x64"
  },
  "build": {
    "appId": "com.iphelper.app",
    "productName": "IPHelper",
    "mac": {
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSHumanReadableCopyright": "Copyright \u00a9 2026 skiperchen"
      },
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "configs/**/*",
      "log.txt"
    ]
  },
  "author": "IPHelper",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}